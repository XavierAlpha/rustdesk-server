[Unit]
Description=Camellia relay server
Documentation=https://github.com/XavierAlpha/rustdesk-server
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/hbbr
User=camellia-server
Group=camellia-server
EnvironmentFile=-/etc/default/camellia-server
StateDirectory=rustdesk-server
StateDirectoryMode=0700
WorkingDirectory=/var/lib/rustdesk-server
UMask=0077
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=20s
LimitNOFILE=65536
TasksMax=4096
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProtectSystem=strict
ProcSubset=pid
ReadWritePaths=/var/lib/rustdesk-server
CapabilityBoundingSet=
AmbientCapabilities=
KeyringMode=private
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallFilter=~@clock @cpu-emulation @debug @module @mount @obsolete @privileged @raw-io @reboot @resources @swap
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
SyslogIdentifier=camellia-hbbr

[Install]
WantedBy=multi-user.target
