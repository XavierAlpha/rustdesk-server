#!/bin/sh
set -e

if ! getent group camellia-server >/dev/null; then
    addgroup --system --quiet camellia-server
fi
if ! getent passwd camellia-server >/dev/null; then
    adduser --system --quiet \
      --ingroup camellia-server \
      --home /var/lib/rustdesk-server \
      --no-create-home \
      --disabled-login \
      --gecos "Camellia server" \
      camellia-server
fi

server_group_gid=$(getent group camellia-server | cut -d: -f3)
server_user_record=$(getent passwd camellia-server)
server_user_gid=$(printf '%s\n' "$server_user_record" | cut -d: -f4)
server_user_home=$(printf '%s\n' "$server_user_record" | cut -d: -f6)
if [ "$server_user_gid" != "$server_group_gid" ] ||
   [ "$server_user_home" != /var/lib/rustdesk-server ]; then
    echo "Existing camellia-server account has an incompatible group or home directory" >&2
    exit 1
fi

install -d -m 0700 -o camellia-server -g camellia-server /var/lib/rustdesk-server

#DEBHELPER#
exit 0
